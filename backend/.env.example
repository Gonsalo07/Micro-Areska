# ==========================================
# Configuración de Base de Datos (PostgreSQL)
# ==========================================
# Configuración específica por servicio (Host, Puerto, DB Name, User, Pass)

# User Service
DB_HOST_USER=localhost
DB_PORT_USER=5432
DB_NAME_USER=areska
DB_USERNAME_USER=postgres
DB_PASSWORD_USER=postgres

# Order Service
DB_HOST_ORDER=localhost
DB_PORT_ORDER=5432
DB_NAME_ORDER=areska
DB_USERNAME_ORDER=postgres
DB_PASSWORD_ORDER=postgres

# Product Service
DB_HOST_PRODUCT=localhost
DB_PORT_PRODUCT=5432
DB_NAME_PRODUCT=areska
DB_USERNAME_PRODUCT=postgres
DB_PASSWORD_PRODUCT=postgres

# Category Service
DB_HOST_CATEGORY=localhost
DB_PORT_CATEGORY=5432
DB_NAME_CATEGORY=areska
DB_USERNAME_CATEGORY=postgres
DB_PASSWORD_CATEGORY=postgres

# Delivery Service
DB_HOST_DELIVERY=localhost
DB_PORT_DELIVERY=5432
DB_NAME_DELIVERY=areska
DB_USERNAME_DELIVERY=postgres
DB_PASSWORD_DELIVERY=postgres

# Payment Service
DB_HOST_PAYMENT=localhost
DB_PORT_PAYMENT=5432
DB_NAME_PAYMENT=areska
DB_USERNAME_PAYMENT=postgres
DB_PASSWORD_PAYMENT=postgres

# ==========================================
# Puertos de Microservicios
# ==========================================
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8080
DELIVERY_SERVICE_PORT=8085

# ==========================================
# Configuración de RabbitMQ
# ==========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ==========================================
# Configuración del Gateway y Eureka
# ==========================================
PORT=8090
EUREKA_URI=http://localhost:8761/eureka/

# ==========================================
# CORS - Orígenes Permitidos
# ==========================================
# Agrega aquí todos los frontends que necesiten acceder al backend
# Ejemplos:
#   - Frontend principal: http://localhost:3000
#   - Frontend delivery: http://localhost:3001
#   - Producción: https://app.areska.com,https://delivery.areska.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8090

# ==========================================
# Configuración de Firebase
# ==========================================
# Opción 1: Todo el JSON en una sola línea (Recomendado para CI/CD y despliegue)
# Defecto: FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "..."}
FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "..."}

# Opción 2: Archivo local
# FIREBASE_CONFIG_PATH=firebase-service-account.json

# Opción 3: Variables Individuales
# FIREBASE_PROJECT_ID=...
# FIREBASE_PRIVATE_KEY_ID=...
# FIREBASE_PRIVATE_KEY=...
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_CLIENT_ID=...
